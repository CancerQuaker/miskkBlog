# 迷失客客の博客 生产部署环境变量
# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env

# ---- 必填 ----
# MySQL root 密码（容器内 root，不对外暴露，但仍请用强密码）
MYSQL_PASSWORD=change-me-strong-password

# JWT 密钥，≥32 位随机字符串（生成示例：openssl rand -base64 48）
JWT_SECRET=please-change-me-to-a-random-32-plus-bytes-secret-0001

# 服务间内部接口令牌（/internal/** 校验用）
INTERNAL_TOKEN=change-me-internal-token

# ---- 可选：国内服务器构建加速 ----
#MAVEN_MIRROR=https://maven.aliyun.com/repository/public
#NPM_REGISTRY=https://registry.npmmirror.com

# ---- 可选：邮件验证码真实发信（不配则调试模式，验证码在响应与用户服务日志中返回）----
#MAIL_HOST=smtp.example.com
#MAIL_USER=noreply@example.com
#MAIL_PASSWORD=xxx

# ---- 可选：GitHub OAuth 登录（不配则登录入口提示未开放）----
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# ---- 可选：Redis 密码（默认部署 Redis 无密码且不对外暴露）----
#REDIS_PASSWORD=
