# 迷失客客の博客 部署环境变量（docker-compose.auto.yml 与 docker-compose.yml 共用）
# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env
# 「必填」三项必须设置；其余注释掉的变量按需打开，等号后的值即默认行为

# ======================= 必填 =======================

# MySQL root 密码（容器内 root；虽不对外暴露，仍请用强密码）
MYSQL_PASSWORD=change-me-strong-password

# JWT 密钥，仅网关使用，≥32 位随机字符串（生成示例：openssl rand -base64 48）
JWT_SECRET=please-change-me-to-a-random-32-plus-bytes-secret-0001

# 服务间内部接口令牌（/internal/** 校验用）
INTERNAL_TOKEN=change-me-internal-token

# ======================= 可选：数据库 / 缓存 =======================

# MySQL 应用账号（默认 root；改用其他账号需自行在初始化脚本里授予
# miskk_user / miskk_article / miskk_friend 三库权限）
#MYSQL_USER=root

# Redis 密码（设置后 redis 以该密码启动，后端服务自动携带；留空 = 无密码）
#REDIS_PASSWORD=

# ======================= 可选：Nacos 控制台鉴权（默认关闭）=======================
# Nacos 只在 compose 内网可达，默认不开鉴权；需要纵深防御时打开。
# 控制台默认账号 nacos/nacos，首次登录后可在控制台改密，并同步到下面两行。

#NACOS_AUTH_ENABLE=true
# 后端服务注册/发现用的账号密码（与控制台账号一致）
#NACOS_USERNAME=nacos
#NACOS_PASSWORD=change-me-nacos-password
# 服务端令牌，Base64 且解码后 ≥32 字节（生成示例：openssl rand -base64 32）
#NACOS_AUTH_TOKEN=
# 服务间身份标识（自定义随机值即可）
#NACOS_AUTH_IDENTITY_KEY=serverIdentity
#NACOS_AUTH_IDENTITY_VALUE=change-me-server-identity

# ======================= 可选：端口 =======================
# 规则：宿主机端口与容器内端口两侧都可自定义，未设置时全部走默认值；
#       MySQL/Redis 的容器内端口改动会自动同步到后端连接配置。
# 安全模型：默认仅 nginx 对外。MySQL/Redis/Nacos 的宿主机映射默认不开放，
#           需要时先取消 compose 文件（auto/yml 两个皆同）里对应服务注释掉的 ports 再改宿主机端口。

# 站点入口（nginx）：宿主机端口即浏览器访问端口；容器内监听端口改 NGINX_PORT
#SITE_PORT=80
#NGINX_PORT=80

# 网关容器内端口（nginx 反代目标，无需对外暴露）
#GATEWAY_PORT=8100

# MySQL：MYSQL_PORT=宿主机 / MYSQL_SERVER_PORT=容器内
#MYSQL_PORT=3306
#MYSQL_SERVER_PORT=3306

# Redis：REDIS_PORT=宿主机 / REDIS_SERVER_PORT=容器内
#REDIS_PORT=6379
#REDIS_SERVER_PORT=6379

# Nacos 仅宿主机端口可调；容器内固定 8848（客户端 gRPC 端口按“服务端口+1000”
# 自动推算，改容器内端口会导致服务注册发现异常）
#NACOS_PORT=8848

# ======================= 可选：运行参数 =======================

# 后端三个 Java 服务的 JVM 参数（2核2G 小内存机器建议 -Xmx256m）
#JAVA_TOOL_OPTIONS=-Xmx256m

# 时区（容器默认 Asia/Shanghai）
#TZ=Asia/Shanghai

# ======================= 可选：本机产物路径（docker-compose.yml 专用）=======================
# auto 版在容器内构建、不读取这些变量；yml 版挂载以下目录启动。相对路径相对 docker/ 目录，
# Windows 绝对路径建议用正斜杠（如 D:/Code/miskkBlog/backend/miskk-gateway/target）。
# 三个后端目录各自只需含一个可执行 jar（按模块名通配启动，jar 带 version 号也无妨）；
# 指向同一个存放全部 jar 的目录也可以。

#GATEWAY_JAR_DIR=../backend/miskk-gateway/target
#USER_JAR_DIR=../backend/miskk-service-user/target
#BLOG_JAR_DIR=../backend/miskk-service-blog/target
#FRONTEND_DIST_DIR=../frontend/dist

# ======================= 可选：国内服务器构建加速 =======================

#MAVEN_MIRROR=https://maven.aliyun.com/repository/public
#NPM_REGISTRY=https://registry.npmmirror.com

# ======================= 可选：邮件验证码真实发信 =======================
# 不配置时为调试模式：验证码直接在注册响应与用户服务日志中返回

#MAIL_HOST=smtp.example.com
#MAIL_PORT=465
#MAIL_USER=noreply@example.com
#MAIL_PASSWORD=xxx
# 调试模式开关（配置了真实邮箱后建议改 false）
#MAIL_DEBUG=true

# ======================= 可选：GitHub OAuth 登录 =======================
# 不配置则登录入口提示未开放

#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
