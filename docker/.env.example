# 迷失客客の博客 部署环境变量（docker-compose.auto.yml 与 docker-compose.yml 共用）
# 复制为 .env 后修改；docker compose 会自动读取同目录的 .env
# 「必填」两项必须设置；其余注释掉的变量按需打开，等号后的值即默认行为

# ======================= 必填 =======================

# PostgreSQL 超级用户（同时也是应用连接账号）密码；虽不对外暴露，仍请用强密码
# POSTGRES_PASSWORD=change-me-strong-password

# 登录态 JWT 密钥，≥32 位随机字符串
# 生成：openssl rand -base64 48，或 mvn -pl backend/miskk-server test -Dtest=SecurityToolTest#generateJwtSecret
JWT_SECRET=please-change-me-to-a-random-32-plus-bytes-secret-0001

# ======================= 可选：数据库 / 缓存 =======================

# PostgreSQL 应用账号（默认 miskk，同时是容器 initdb 建库账号；库固定 miskk_blog）
#POSTGRES_USER=miskk

# Redis 密码（设置后 redis 以该密码启动，后端自动携带；留空 = 无密码）
#REDIS_PASSWORD=

# ======================= 可选：端口 =======================
# 规则：宿主机端口与容器内端口两侧都可自定义，未设置时全部走默认值；
#       PostgreSQL/Redis 的容器内端口改动会自动同步到后端连接配置。
# 安全模型：默认仅 nginx 对外。PostgreSQL/Redis 的宿主机映射默认不开放，
#           需要时先取消 compose 文件（auto/yml 两个皆同）里对应服务注释掉的 ports 再改宿主机端口。

# 站点入口（nginx）：宿主机端口即浏览器访问端口；容器内监听端口改 NGINX_PORT
#SITE_PORT=80
#NGINX_PORT=80

# 后端容器内端口（nginx 反代目标；docker-compose.yml 另映射到宿主机 127.0.0.1:8100）
#APP_PORT=8100

# PostgreSQL：POSTGRES_PORT=宿主机 / POSTGRES_SERVER_PORT=容器内
#POSTGRES_PORT=5432
#POSTGRES_SERVER_PORT=5432

# Redis：REDIS_PORT=宿主机 / REDIS_SERVER_PORT=容器内
#REDIS_PORT=6379
#REDIS_SERVER_PORT=6379

# ======================= 可选：运行参数 =======================

# 后端 JVM 参数（JVM 标准变量，自动生效）
# docker-compose.yml 不设置时的默认：-XX:MaxRAMPercentage=60.0 -XX:+UseSerialGC —— 堆随
# app 的 mem_limit（512m）自动适配约 300m 堆，已按 2核2G 服务器调优；需固定堆大小时才需要覆盖
#JAVA_TOOL_OPTIONS=-Xmx256m

# 时区（容器默认 Asia/Shanghai）
#TZ=Asia/Shanghai

# ======================= 可选：本机文件路径（docker-compose.yml 专用）=======================
# auto 版在容器内构建前后端，不读取这些变量；yml 版挂载以下本机文件/目录启动。
# 相对路径均以 docker/ 目录为基准；Windows 绝对路径建议用正斜杠（如 D:/Code/miskkBlog/...）。

# 后端可执行 jar 文件（直接指定文件，不再按目录通配符匹配）
#APP_JAR_FILE=../backend/miskk-server/target/miskk-server-1.0.0.jar

# 前端打包产物目录（目录内必须包含 index.html）
#FRONTEND_DIST_DIR=../frontend/dist

# PostgreSQL 初始化脚本（仅在空数据卷首次初始化时自动执行）
#SQL_INIT_FILE=../sql/miskk_blog.sql

# nginx 模板（启动时渲染为 /etc/nginx/conf.d/default.conf）
#NGINX_CONF_FILE=./miskk-nginx.conf

# ======================= 可选：国内服务器构建加速 =======================

#MAVEN_MIRROR=https://maven.aliyun.com/repository/public
#NPM_REGISTRY=https://registry.npmmirror.com

# ======================= 可选：邮件验证码真实发信 =======================
# 不配置时为调试模式：验证码直接在注册响应与后端日志中返回

#MAIL_HOST=smtp.example.com
#MAIL_PORT=465
#MAIL_USER=noreply@example.com
#MAIL_PASSWORD=xxx
# 调试模式开关（配置了真实邮箱后建议改 false）
#MAIL_DEBUG=true

# ======================= 可选：GitHub OAuth 登录 =======================
# 不配置则登录入口提示未开放

#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
