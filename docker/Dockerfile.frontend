# syntax=docker/dockerfile:1
# 前端镜像：容器内 npm build（含 tsc 类型检查），产物由 nginx 托管
# 构建上下文必须是仓库根目录
FROM node:22-alpine AS build
# 国内构建加速（可选）：--build-arg NPM_REGISTRY=https://registry.npmmirror.com
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm config set registry ${NPM_REGISTRY} && npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
ENV TZ=Asia/Shanghai
# 经 template 机制渲染：容器启动时用环境变量替换 NGINX_PORT / GATEWAY_PORT
# （生成 /etc/nginx/conf.d/default.conf，未定义时为 .env/compose 默认值）
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
# 实际监听端口运行时由 NGINX_PORT 决定（默认 80），EXPOSE 仅作声明故省略
